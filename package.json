{
  "name": "llm-gateway",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:gateway": "npm run dev -w apps/gateway",
    "dev:worker": "npm run dev -w apps/worker",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": ["apps/*", "packages/*", "mock-provider"]
}